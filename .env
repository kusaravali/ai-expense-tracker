# Copy this file to ".env" and fill in your values.
# Never upload your real .env file to GitHub.

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite file is stored
DATABASE_PATH=finance.db

# Currency symbol shown in the app
CURRENCY_SYMBOL=₹

# ---- LLM settings (all optional: without a key the app uses simple built-in rules) ----
# Choose one: anthropic | openai   (leave empty to auto-detect from the keys below)
LLM_PROVIDER=

# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-haiku-5-5

# Option B: OpenAI (or any OpenAI-compatible service such as Groq / Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
